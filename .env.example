# ============ default: everything through OpenAI gpt-4.1 ============
REELSCOUT_LLM=openai
REELSCOUT_MODEL=gpt-4.1                 # gpt-4.1 handles images too, so the frame pass uses it as well
OPENAI_API_KEY=                         # keep it only in this file; never commit .env or paste it into chats
REELSCOUT_TEXT_POLICY=auto              # auto: skip the first LLM call when local evidence is already decisive | always | never
REELSCOUT_WHISPER=small                 # local speech-to-text: tiny | base | small | medium
GITHUB_TOKEN=                           # optional, raises GitHub API rate limit
# SEARXNG_URL=http://localhost:8080     # optional self-hosted search (JSON output must be enabled)

# ============ per-stage overrides (optional) ============
# Stages: TEXT = read the evidence, VISION = look at frames, RESEARCH = turn clues into a name via search.
# Unset = use REELSCOUT_LLM / REELSCOUT_MODEL above. Example: cheap local model for TEXT, gpt-4.1 for research:
# REELSCOUT_LLM=ollama
# REELSCOUT_MODEL=qwen2.5:3b
# REELSCOUT_RESEARCH_LLM=openai
# REELSCOUT_RESEARCH_MODEL=gpt-4.1
# REELSCOUT_VISION_LLM=openai
# REELSCOUT_VISION_MODEL=gpt-4.1

# ============ Ollama (free, local) ============
# ollama pull qwen2.5:3b ; set REELSCOUT_LLM=ollama and REELSCOUT_MODEL=qwen2.5:3b (7B models are slow on laptops)
# REELSCOUT_TIMEOUT=600                 # seconds per LLM call

# ============ other hosted providers ============
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
